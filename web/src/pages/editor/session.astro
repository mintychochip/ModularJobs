---
import Base from '../../layouts/Base.astro';
---

<!--
  Secure session editor is the React app under web/session-editor.
  It talks to web/rest-api (Postgres), not bytebin.lucko.me.
  The public code stays in the query; the secret token stays in the hash fragment.
-->
<Base title="Edit Jobs — Secure Session">
  <div class="container mx-auto p-4 space-y-4">
    <div class="rounded-lg border border-slate-600 bg-slate-900 p-4 text-slate-100">
      <h1 class="text-2xl font-semibold mb-2">Secure Session Editor</h1>
      <p class="mb-3 text-slate-300">
        Job task sessions are loaded and saved through the ModularJobs session API
        (Rust + PostgreSQL). Session <strong>code</strong> and <strong>token</strong> are required.
      </p>
      <p class="mb-4 text-sm text-slate-400">
        Production editor: React app at <code>web/session-editor</code>
        (<code>VITE_SESSION_API_URL</code>). Bytebin is not used for this path.
      </p>
      <a
        id="open-react-editor"
        class="inline-block rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700"
        href="/session-editor/"
      >
        Open React session editor
      </a>
    </div>
    <iframe
      id="session-editor-frame"
      title="ModularJobs Session Editor"
      class="w-full min-h-[70vh] rounded-lg border border-slate-700 bg-slate-950"
      src=""
    ></iframe>
  </div>
  <script>
    const params = new URLSearchParams(window.location.search);
    const hashParams = new URLSearchParams(window.location.hash.replace(/^#/, ''));
    const code = hashParams.get('code') ?? params.get('code') ?? params.get('session') ?? '';
    const token =
      hashParams.get('token') ??
      hashParams.get('sessionToken') ??
      params.get('token') ??
      params.get('sessionToken') ??
      '';

    const query = new URLSearchParams();
    if (code) query.set('code', code);

    const fragment = new URLSearchParams();
    if (token) fragment.set('token', token);

    const target =
      `/session-editor/${query.toString() ? `?${query}` : ''}` +
      `${fragment.toString() ? `#${fragment}` : ''}`;
    const link = document.getElementById('open-react-editor');
    if (link instanceof HTMLAnchorElement) link.href = target;
    const frame = document.getElementById('session-editor-frame');
    if (frame instanceof HTMLIFrameElement) frame.src = target;
  </script>
</Base>
