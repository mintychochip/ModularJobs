---
// Legacy Paper-generated /editor/session?code=...#token=... handoff.
// Redirects client-side to the canonical /editor/ route. The token stays in
// the hash and is never sent to the server, so it does not appear in logs.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting to session editor…</title>
  </head>
  <body>
    <script is:inline>
      (function () {
        const target = new URL('/editor/', window.location.origin);
        target.search = window.location.search.substring(1);
        target.hash = window.location.hash.substring(1);
        window.location.replace(target.toString());
      })();
    </script>
  </body>
</html>
