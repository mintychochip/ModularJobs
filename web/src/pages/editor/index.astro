---
import Base from '../../layouts/Base.astro';
---

<Base title="Web Editor">
  <div class="container mx-auto p-8 max-w-2xl">
    <h1 class="text-3xl font-bold mb-6">ModularJobs Web Editor</h1>

    <div class="card bg-base-200 shadow-xl mb-6">
      <div class="card-body">
        <h2 class="card-title">How to use</h2>
        <ol class="list-decimal list-inside space-y-2">
          <li>Run <code class="kbd kbd-sm">/jobs editor</code> in-game</li>
          <li>Click the link provided or paste the session code and token below</li>
          <li>Edit your job tasks in the table</li>
          <li>Click Save and run <code class="kbd kbd-sm">/jobs applyedits CODE</code></li>
        </ol>
      </div>
    </div>

    <div class="space-y-4">
      <div class="form-control">
        <label class="label">
          <span class="label-text">Session Code</span>
        </label>
        <div class="join">
          <input type="text" id="code-input" placeholder="Paste code here..."
                 class="input input-bordered join-item flex-1" autocomplete="off" />
        </div>
      </div>
      <div class="form-control">
        <label class="label">
          <span class="label-text">Session Token</span>
        </label>
        <input type="password" id="token-input" placeholder="Paste token here..."
               class="input input-bordered" autocomplete="off" />
      </div>
      <button id="load-btn" class="btn btn-primary">Load Session</button>
    </div>
  </div>

  <script>
    const loadSession = () => {
      const code = (document.getElementById('code-input') as HTMLInputElement)?.value?.trim() ?? '';
      const token = (document.getElementById('token-input') as HTMLInputElement)?.value?.trim() ?? '';
      if (!code || !token) {
        window.alert('Enter both the session code and token.');
        return;
      }

      const query = new URLSearchParams({code});
      const fragment = new URLSearchParams({token});
      window.location.href = `/editor/session?${query}#${fragment}`;
    };

    document.getElementById('load-btn')?.addEventListener('click', loadSession);

    const handleKeypress = (event: KeyboardEvent) => {
      if (event.key === 'Enter') {
        loadSession();
      }
    };

    document.getElementById('code-input')?.addEventListener('keypress', handleKeypress);
    document.getElementById('token-input')?.addEventListener('keypress', handleKeypress);
  </script>
</Base>
