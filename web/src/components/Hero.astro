---
import { GITHUB_URL } from '../lib/releases'

interface Props {
  version?: string
}

const { version } = Astro.props
---

<section class="hero">
  <p class="hero-role">
    PaperMC plugin<span data-release-version-line hidden={!version}>
      · v<span data-release-version>{version}</span></span
    >
  </p>
  <h1 class="hero-name">ModularJobs</h1>
  <p class="hero-tagline">
    An extensible job progression plugin for Minecraft servers — configure jobs, tasks,
    payables, boosts, and upgrade trees, all from a secure web editor.
  </p>
  <div class="hero-actions">
    <a class="button button-primary" href="#download">Download latest build</a>
    <a class="button" href="/docs/">Get started</a>
    <a class="button" href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
  </div>
</section>
