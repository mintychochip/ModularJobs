---
const { version } = Astro.props
---
<div class="w-full bg-base-300">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col items-center gap-8 text-center md:flex-row md:justify-between md:text-left">
      <div class="flex flex-col items-center gap-6 md:flex-row md:items-center">
        <div class="shrink-0">
          <img src="/houston.webp" alt="ModularJobs Logo"
               class="h-32 w-32 object-cover rounded-xl" />
        </div>
        <div>
          <h1 class="text-5xl font-bold">ModularJobs</h1>
          <p class="mt-3 text-lg opacity-80 max-w-xl">
            A extensible job progression plugin for Minecraft servers &mdash; configure jobs, tasks,
            payables, boosts, and upgrade trees, all from a secure web editor.
          </p>
          <div class="mt-6 flex flex-wrap justify-center gap-4 md:justify-start">
            <a href="/wiki/" class="btn btn-primary btn-lg">Get Started</a>
            <a href="https://github.com/aincraft-org/modularjobs"
               class="btn btn-outline btn-lg">
              <img src="/GitHub_Invertocat_Light.svg" alt="Github Logo" class="h-5" />
              GitHub
            </a>
          </div>
        </div>
      </div>
      <div class="text-center md:text-right opacity-80">
        <span class="text-sm">Version</span>
        <div class="text-2xl font-bold">{version}</div>
      </div>
    </div>
  </div>
</div>
