{
  "name": "modularjobs-web",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": "20.x || 22.x"
  },
  "scripts": {
    "dev": "npm run build:editor && astro dev",
    "start": "npm run build:editor && astro dev",
    "build": "npm run build:editor && npm run build:docs && astro build && rm -rf dist/docs && cp -r fumadocs/out dist/docs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "build:editor": "cd session-editor && npm ci --include=dev && npm run build && cd .. && rm -rf public/editor && mkdir -p public/editor && cp -r session-editor/dist/. public/editor/",
    "build:docs": "cd fumadocs && npm ci --include=dev && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/vue": "^5.1.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^5.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.34.2",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.0.50",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "vitest": "^4.1.10"
  }
}
