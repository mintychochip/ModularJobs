<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
  Path-based suppressions. Prefer fixing code over growing this file.
  Patterns are matched against the absolute source file path.
-->
<suppressions>
    <!-- Generated / build outputs if ever scanned -->
    <suppress files="[\\/]build[\\/]" checks=".*"/>
    <suppress files="[\\/]generated[\\/]" checks=".*"/>
</suppressions>
