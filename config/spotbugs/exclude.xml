<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclude filter. Prefer fixing findings over expanding this list.
  See: https://spotbugs.readthedocs.io/en/latest/filter.html
-->
<FindBugsFilter>
    <!-- Generated sources (if any end up on the classpath) -->
    <Match>
        <Source name="~.*[\\/]generated[\\/].*"/>
    </Match>

    <!-- Test sources: relax a few noisy patterns -->
    <Match>
        <Class name="~.*Test.*"/>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR,NP_NONNULL_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR,NP_NONNULL_RETURN_VIOLATION,BC_VACUOUS_INSTANCEOF,RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    </Match>

    <!-- Encapsulation of mutable DTO/collection fields. Copy-on-write is a
         follow-up; fail-closed style gate should not block on these. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,EI_EXPOSE_STATIC_REP2,MS_EXPOSE_REP"/>
    </Match>

    <!-- Gson/Bukkit getters are @Nullable in bytecode; callers already guard. -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>

    <!-- Private utility constructors throw to block reflection. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <Match>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE,RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE,HE_INHERITS_EQUALS_USE_HASHCODE"/>
    </Match>
</FindBugsFilter>
